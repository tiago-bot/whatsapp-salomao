# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
DEFAULT_MODEL=gpt-5.6-sol
PRIMARY_REASONING_EFFORT=xhigh
DEFAULT_MINI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_MODEL=gpt-transcribe

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=inchurch-hubspot-kb
PINECONE_HOST=https://your-index.svc.pinecone.io
PINECONE_SCORE_THRESHOLD=0.3

# Catálogo publicado da Central (opcional; sem ele usa o Pinecone)
KB_SUPABASE_URL=
KB_SUPABASE_ANON_KEY=
# Completa o melhor resultado legado do Pinecone lendo o artigo oficial atual.
KB_LIVE_ARTICLE_HYDRATION_ENABLED=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Memoria de mensagens observadas, isolada dos rascunhos e do bot antigo.
SUPABASE_CONVERSATION_MEMORY_ENABLED=true

# HubSpot
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
# Obrigatórios antes de publicar main_hubspot:app. Nunca usar tokens no frontend.
# Gere ADMIN_API_TOKEN com secrets.token_urlsafe(32); mínimo de 32 caracteres.
ADMIN_API_TOKEN=
# Client secret do aplicativo HubSpot (não é o access token).
HUBSPOT_CLIENT_SECRET=
# URL HTTPS exata registrada no HubSpot, incluindo query string se houver.
HUBSPOT_WEBHOOK_URL=https://whatsapp-salomao-production.up.railway.app/webhook/hubspot
# Ative apenas se o aplicativo enviar exclusivamente assinaturas v1.
# Exige occurredAt assinado recente (24h) e deduplicação persistente.
HUBSPOT_WEBHOOK_ALLOW_V1=false
# Origens administrativas autorizadas, separadas por vírgula. Vazio bloqueia CORS.
CORS_ORIGINS=
# /health: processo vivo. /ready: prontidão (503 em falhas).
HEALTH_POLLING_MAX_AGE_SECONDS=300
HEALTH_DELIVERY_MAX_AGE_SECONDS=300
HUBSPOT_SALOMAO_PIPELINE=636594474
HUBSPOT_SALOMAO_STATUS=1135170476
HUBSPOT_SALOMAO_ENTRY_PROPERTY=hs_v2_date_entered_1135170476
HUBSPOT_SALOMAO_ACTOR_ID=A-81908844
# Destino do atendimento humano: pipeline Suporte N1, status Novo.
HUBSPOT_HUMAN_PIPELINE=636459134
HUBSPOT_HUMAN_STATUS=939275049

# Desligue durante testes locais para NÃO responder clientes reais.
HUBSPOT_POLLING_ENABLED=false
HUBSPOT_POLLING_INTERVAL=10
# Pausa de 5s desde a ultima mensagem; teto fixo de 20s por lote.
HUBSPOT_MESSAGE_DEBOUNCE_SECONDS=5
# INFO: eventos operacionais e resumo de polling a cada 60s (ou quando mudar).
# DEBUG: detalhes das verificações, sem textos de clientes ou credenciais.
LOG_LEVEL=INFO
WHATSAPP_MAX_MESSAGE_LENGTH=3500
# Em produção: uma instância/worker e volume persistente para esta base.
# O Compose fixa este caminho e monta o volume nomeado salomao-delivery-data em /data.
# Railway: configurar a variável e o volume no serviço (Compose não é usado ali).
# DELIVERY_DB_PATH=/data/salomao-delivery.sqlite3

# Diagnóstico de eventos; nunca coloque tokens no código.
INRADAR_AUTH_TOKEN=
