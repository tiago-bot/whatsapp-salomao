# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
DEFAULT_MODEL=gpt-5.5
DEFAULT_MINI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=inchurch-hubspot-kb
PINECONE_HOST=https://your-index.svc.pinecone.io
PINECONE_SCORE_THRESHOLD=0.3

# Catálogo publicado da Central (opcional; sem ele usa o Pinecone)
KB_SUPABASE_URL=
KB_SUPABASE_ANON_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Memoria de mensagens observadas, isolada dos rascunhos e do bot antigo.
SUPABASE_CONVERSATION_MEMORY_ENABLED=true

# HubSpot
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
HUBSPOT_SALOMAO_PIPELINE=636594474
HUBSPOT_SALOMAO_STATUS=1269308450
HUBSPOT_SALOMAO_ENTRY_PROPERTY=hs_v2_date_entered_1269308450
HUBSPOT_SALOMAO_ACTOR_ID=A-81908844
# Destino do atendimento humano: pipeline Suporte N1, status Novo.
HUBSPOT_HUMAN_PIPELINE=636459134
HUBSPOT_HUMAN_STATUS=939275049

# Desligue durante testes locais para NÃO responder clientes reais.
HUBSPOT_POLLING_ENABLED=false
HUBSPOT_POLLING_INTERVAL=10
# Pausa de 5s desde a ultima mensagem; teto fixo de 20s por lote.
HUBSPOT_MESSAGE_DEBOUNCE_SECONDS=5
# INFO: eventos operacionais e resumo de polling a cada 60s (ou quando mudar).
# DEBUG: detalhes das verificações, sem textos de clientes ou credenciais.
LOG_LEVEL=INFO
WHATSAPP_MAX_MESSAGE_LENGTH=3500
# Em produção: uma instância/worker e volume persistente para esta base.
# DELIVERY_DB_PATH=/data/salomao-delivery.sqlite3

# Diagnóstico de eventos; nunca coloque tokens no código.
INRADAR_AUTH_TOKEN=
